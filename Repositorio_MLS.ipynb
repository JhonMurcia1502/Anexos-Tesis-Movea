      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import matplotlib.animation as animation\n",
        "from matplotlib import rc\n",
        "import cartopy.crs as ccrs\n",
        "import cartopy.feature as cfeature\n",
        "from scipy.stats import binned_statistic_2d\n",
        "import numpy as np\n",
        "import os\n",
        "import warnings\n",
        "\n",
        "rc('animation', html='jshtml')\n",
        "warnings.filterwarnings(\"ignore\")\n",
        "\n",
        "# ================= CONFIGURACIÓN =================\n",
        "TARGET_PRESSURE = 100.0\n",
        "# Región a animar ('GLOBAL', 'ASIA', o 'NAM')\n",
        "REGION_SELECCIONADA = 'NAM'\n",
        "REGIONES = {\n",
        "    'GLOBAL': None,\n",
        "    'ASIA': [40, 110, 5, 45],\n",
        "    'NAM': [-130, -60, 10, 50]\n",
        "}\n",
        "GRID_RES = 2.5 # Resolución ajustada para suavizado topológico\n",
        "\n",
        "LEVELS_TEMP = np.linspace(190, 235, 20) # K\n",
        "LEVELS_H2O = np.linspace(2.5, 6.5, 20)  # ppmv\n",
        "\n",
        "# --- 1. CARGA ULTRA-RÁPIDA (Datos Parquet) ---\n",
        "print(\"Cargando datos optimizados...\")\n",
        "try:\n",
        "    df_temp = pd.read_parquet(os.path.join(BASE_DIR, 'DATOS_OPTIMIZADOS_Temperature_100hPa.parquet'))\n",
        "    df_h2o = pd.read_parquet(os.path.join(BASE_DIR, 'DATOS_OPTIMIZADOS_H2O_100hPa.parquet'))\n",
        "    df_h2o['value'] = df_h2o['value'] * 1e6 # Conversión a ppmv\n",
        "    print(f\"¡Datos cargados! Temp: {len(df_temp)}, H2O: {len(df_h2o)}\")\n",
        "except FileNotFoundError:\n",
        "    raise Exception(\"ERROR: No se encontraron los archivos .parquet. Ejecutar procesamiento previo.\")\n",
        "\n",
        "# --- 2. PROCESAMIENTO MENSUAL Y GRILLADO ---\n",
        "def obtener_grillas_mensuales_suaves(df):\n",
        "    df['mes'] = df['date'].dt.to_period('M').astype(str)\n",
        "    lat_bins = np.arange(-90, 90 + GRID_RES, GRID_RES)\n",
        "    lon_bins = np.arange(-180, 180 + GRID_RES, GRID_RES)\n",
        "    grids, meses = {}, sorted(df['mes'].unique())\n",
        "\n",
        "    print(f\"Grillando espacialmente {len(meses)} meses...\")\n",
        "    for m in meses:\n",
        "        d = df[df['mes'] == m]\n",
        "        if len(d) > 100:\n",
        "            H, _, _, _ = binned_statistic_2d(d['lon'], d['lat'], d['value'], statistic='mean', bins=[lon_bins, lat_bins])\n",
        "            grids[m] = np.ma.masked_invalid(H.T)\n",
        "        else:\n",
        "            grids[m] = None\n",
        "\n",
        "    lon_c = (lon_bins[:-1] + lon_bins[1:]) / 2\n",
        "    lat_c = (lat_bins[:-1] + lat_bins[1:]) / 2\n",
        "    X, Y = np.meshgrid(lon_c, lat_c)\n",
        "    return grids, meses, X, Y\n",
        "\n",
        "grids_t, mt, X, Y = obtener_grillas_mensuales_suaves(df_temp)\n",
        "grids_h, mh, _, _ = obtener_grillas_mensuales_suaves(df_h2o)\n",
        "common_months = sorted(list(set(mt) & set(mh)))\n",
        "\n",
        "# --- 3. CONFIGURACIÓN GRÁFICA Y ANIMACIÓN ---\n",
        "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(18, 7), subplot_kw={'projection': ccrs.PlateCarree()})\n",
        "extent = REGIONES[REGION_SELECCIONADA]\n",
        "\n",
        "def config_map_base(ax, title):\n",
        "    ax.coastlines(resolution='110m', linewidth=1.2)\n",
        "    ax.add_feature(cfeature.BORDERS, linestyle=':', linewidth=1)\n",
        "    if extent: ax.set_extent(extent, crs=ccrs.PlateCarree())\n",
        "    ax.set_title(title, fontsize=14, fontweight='bold')\n",
        "    gl = ax.gridlines(draw_labels=True, linestyle='--', alpha=0.5)\n",
        "    gl.top_labels = False\n",
        "    gl.right_labels = False\n",
        "\n",
        "config_map_base(ax1, f'Temperatura ({REGION_SELECCIONADA})')\n",
        "config_map_base(ax2, f'Vapor de Agua ({REGION_SELECCIONADA})')\n",
        "\n",
        "cont1 = ax1.contourf(X, Y, np.zeros_like(X), levels=LEVELS_TEMP, cmap='RdYlBu_r', transform=ccrs.PlateCarree(), extend='both')\n",
        "cont2 = ax2.contourf(X, Y, np.zeros_like(X), levels=LEVELS_H2O, cmap='jet', transform=ccrs.PlateCarree(), extend='max')\n",
        "\n",
        "cbar1 = plt.colorbar(cont1, ax=ax1, orientation='horizontal', pad=0.1, fraction=0.05)\n",
        "cbar1.set_label('Temperatura (K)', fontsize=12)\n",
        "cbar2 = plt.colorbar(cont2, ax=ax2, orientation='horizontal', pad=0.1, fraction=0.05)\n",
        "cbar2.set_label('H$_2$O (ppmv)', fontsize=12)\n",
        "\n",
        "st = fig.suptitle('Inicializando...', fontsize=16, y=0.95)\n",
        "\n",
        "plot_t_handle = None\n",
        "plot_h_handle = None\n",
        "\n",
        "def limpiar_contornos(handle):\n",
        "    if handle is None: return\n",
        "    try:\n",
        "        for c in handle.collections: c.remove()\n",
        "        return\n",
        "    except AttributeError: pass\n",
        "    try:\n",
        "        for c in handle: c.remove()\n",
        "        return\n",
        "    except TypeError: pass\n",
        "    try:\n",
        "        handle.remove()\n",
        "    except: pass\n",
        "\n",
        "def update_smooth(frame):\n",
        "    global plot_t_handle, plot_h_handle\n",
        "    m = common_months[frame]\n",
        "\n",
        "    limpiar_contornos(plot_t_handle)\n",
        "    limpiar_contornos(plot_h_handle)\n",
        "\n",
        "    if grids_t.get(m) is not None and not grids_t[m].mask.all():\n",
        "        plot_t_handle = ax1.contourf(X, Y, grids_t[m], levels=LEVELS_TEMP, cmap='RdYlBu_r', transform=ccrs.PlateCarree(), extend='both')\n",
        "\n",
        "    if grids_h.get(m) is not None and not grids_h[m].mask.all():\n",
        "        plot_h_handle = ax2.contourf(X, Y, grids_h[m], levels=LEVELS_H2O, cmap='jet', transform=ccrs.PlateCarree(), extend='max')\n",
        "\n",
        "    st.set_text(f'Evolución Mensual MLS @ {TARGET_PRESSURE} hPa - Fecha: {m}')\n",
        "    return ax1, ax2\n",
        "\n",
        "print(f\"Renderizando {len(common_months)} frames...\")\n",
        "ani = animation.FuncAnimation(fig, update_smooth, frames=len(common_months), interval=200, blit=False)\n",
        "\n",
        "output_file = os.path.join(BASE_DIR, f'Timelapse_SMOOTH_{REGION_SELECCIONADA}.mp4')\n",
        "ani.save(output_file, writer='ffmpeg', dpi=120)\n",
        "print(f\"✅ ¡VIDEO FINAL GUARDADO! Revisa en tu Drive: {output_file}\")\n",
        "plt.close()"
