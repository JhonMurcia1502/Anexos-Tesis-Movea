        "Ingesta y Estructuración de Datos del Instrumento MLS\n",
        "\n",
        "En esta sección se define la función principal de lectura para extraer la información bruta de los archivos jerárquicos HDF-EOS5 (.he5). Utilizando la librería h5py, se aíslan los campos de datos (valores de mezcla) y geolocalización (latitud, longitud, presión y tiempo).\n",
        "\n",
        "Durante la lectura, se aplica el primer filtro de calidad estipulado por la NASA: se descartan todas las mediciones cuya precisión instrumental sea menor o igual a cero, reemplazándolas por valores nulos (NaN). Finalmente, los perfiles individuales se concatenan mediante xarray en un único tensor multidimensional continuo a lo largo de la coordenada temporal, facilitando su posterior indexación espacial y filtrado termodinámico."
      ],
      "metadata": {
        "id": "Qeo3qIKPTHr8"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "pip install xarray\n",
        "import xarray as xr\n",
        "import numpy as np\n",
        "import os\n",
        "import glob\n",
        "import warnings\n",
        "import h5py # Usaremos h5py para leer la estructura interna\n",
        "\n",
        "# --- Configuración Inicial ---\n",
        "warnings.filterwarnings(\"ignore\", category=UserWarning, module=\"h5py\")\n",
        "\n",
        "# ACTUALIZA ESTAS RUTAS a la ubicación\n",
        "H2O_DATA_PATH = os.path.join(BASE_DIR, \"DatosMLS\")\n",
        "TEMP_DATA_PATH = os.path.join(BASE_DIR, \"DatosMLS_Temp\")\n",
        "\n",
        "# --- Función de Carga y Filtrado de Calidad (Versión Corregida) ---\n",
        "\n",
        "def load_and_preprocess_mls(file_path, var_name, var_swath_name):\n",
        "    \"\"\"\n",
        "    Abre un único archivo HDF-EOS de MLS usando h5py para navegar\n",
        "    la estructura de grupos, aplica filtros de calidad y\n",
        "    construye un DataArray de Xarray.\n",
        "\n",
        "    Args:\n",
        "        file_path (str): Ruta al archivo .he5\n",
        "        var_name (str): Nombre que le daremos a la variable (ej. \"H2O\")\n",
        "        var_swath_name (str): Nombre del grupo Swath en el HDF5 (ej. \"H2O\" o \"Temperature\")\n",
        "    \"\"\"\n",
        "    try:\n",
        "        with h5py.File(file_path, 'r') as f:\n",
        "            # 1. Definir las rutas completas a los datasets\n",
        "            base_path = f\"HDFEOS/SWATHS/{var_swath_name}\"\n",
        "\n",
        "            data_path = f\"{base_path}/Data Fields/L2gpValue\"\n",
        "            prec_path = f\"{base_path}/Data Fields/L2gpPrecision\"\n",
        "\n",
        "            lat_path = f\"{base_path}/Geolocation Fields/Latitude\"\n",
        "            lon_path = f\"{base_path}/Geolocation Fields/Longitude\"\n",
        "            time_path = f\"{base_path}/Geolocation Fields/Time\"\n",
        "            press_path = f\"{base_path}/Geolocation Fields/Pressure\" # Eje vertical\n",
        "\n",
        "            # 2. Extraer los datos como arrays de NumPy\n",
        "            data_raw = f[data_path][:]\n",
        "            precision = f[prec_path][:]\n",
        "\n",
        "            latitude = f[lat_path][:]\n",
        "            longitude = f[lon_path][:]\n",
        "            time_raw = f[time_path][:] # Esto es TAI93 (segundos desde 1993-01-01)\n",
        "            pressure = f[press_path][:]\n",
        "\n",
        "            # 3. Aplicar el filtro de calidad recomendado por la NASA\n",
        "            # Donde L2gpPrecision < 0, los datos no son válidos (reemplazamos con NaN)\n",
        "            data_filtered = np.where(precision > 0, data_raw, np.nan)\n",
        "\n",
        "            # 4. Convertir el tiempo TAI93 a datetime64[ns]\n",
        "            # TAI93 (International Atomic Time) epoch es 1993-01-01.\n",
        "            # Xarray/Numpy epoch ('unix') es 1970-01-01.\n",
        "            # Necesitamos sumar los segundos entre 1970 y 1993.\n",
        "            # TAI93 = 0 en 1993-01-01 00:00:00 UTC\n",
        "            # Epoch (1970-01-01) a 1993-01-01 = 725846400 segundos\n",
        "            # (Xarray a veces maneja TAI93 automáticamente, pero esto es más robusto)\n",
        "            # time_datetime = pd.to_datetime(time_raw, unit='s', origin='1993-01-01')\n",
        "            # La forma más simple y robusta con numpy puro:\n",
        "            time_datetime = (time_raw.astype('timedelta64[s]') +\n",
        "                             np.datetime64('1993-01-01T00:00:00Z'))\n",
        "\n",
        "            # 5. Construir el DataArray de Xarray\n",
        "            # Las dimensiones de los datos L2 (ej. L2gpValue) son [nTimes, nLevels]\n",
        "            # Asignamos las coordenadas a esas dimensiones\n",
        "            da = xr.DataArray(\n",
        "                data_filtered,\n",
        "                coords={\n",
        "                    'nTimes': time_datetime, # Coordenada de tiempo (para concatenar)\n",
        "                    'pressure': pressure,     # Coordenada vertical\n",
        "                    'lat': ('nTimes', latitude),    # Coordenada auxiliar\n",
        "                    'lon': ('nTimes', longitude)    # Coordenada auxiliar\n",
        "                },\n",
        "                dims=['nTimes', 'pressure'], # Nombres de las dimensiones\n",
        "                name=var_name\n",
        "            )\n",
        "\n",
        "            # 6. Renombrar la dimensión de tiempo para que 'time' sea la coordenada\n",
        "            da = da.rename({'nTimes': 'time'})\n",
        "\n",
        "            return da\n",
        "\n",
        "    except Exception as e:\n",
        "        print(f\"Error procesando {file_path}: {e}\")\n",
        "        return None\n",
        "\n",
        "# --- Búsqueda y Procesamiento de Archivos ---\n",
        "\n",
        "print(f\"Buscando archivos de H2O en: {H2O_DATA_PATH}\")\n",
        "h2o_files = sorted(glob.glob(os.path.join(H2O_DATA_PATH, \"**\", \"*.he5\"), recursive=True))\n",
        "\n",
        "print(f\"Buscando archivos de Temperatura en: {TEMP_DATA_PATH}\")\n",
        "temp_files = sorted(glob.glob(os.path.join(TEMP_DATA_PATH, \"**\", \"*.he5\"), recursive=True))\n",
        "\n",
        "print(f\"Encontrados {len(h2o_files)} archivos de H2O.\")\n",
        "print(f\"Encontrados {len(temp_files)} archivos de Temperatura.\")\n",
        "\n",
        "# --- Procesar H2O ---\n",
        "h2o_data_list = []\n",
        "# (Limitamos a 100 solo para una prueba rápida, quita [0:100] para procesar todo)\n",
        "print(\"Procesando H2O (lote de prueba de 100 archivos)...\")\n",
        "for f in h2o_files[0:100]:\n",
        "#print(\"Procesando TODOS los archivos de H2O...\")\n",
        "#for f in h2o_files:\n",
        "    data = load_and_preprocess_mls(f, var_name=\"H2O\", var_swath_name=\"H2O\")\n",
        "    if data is not None:\n",
        "        h2o_data_list.append(data)\n",
        "\n",
        "# --- Procesar Temperatura ---\n",
        "temp_data_list = []\n",
        "# (Limitamos a 100 solo para una prueba rápida, quita [0:100] para procesar todo)\n",
        "print(\"Procesando Temperatura (lote de prueba de 100 archivos)...\")\n",
        "for f in temp_files[0:100]:\n",
        "#print(\"Procesando TODOS los archivos de Temperatura...\")\n",
        "#for f in temp_files:\n",
        "    data = load_and_preprocess_mls(f, var_name=\"Temp\", var_swath_name=\"Temperature\")\n",
        "    if data is not None:\n",
        "        temp_data_list.append(data)\n",
        "\n",
        "# --- Concatenación Final ---\n",
        "\n",
        "if h2o_data_list and temp_data_list:\n",
        "    print(\"\\nConcatenando archivos (esto puede tardar)...\")\n",
        "\n",
        "    # Combinar todos los archivos diarios en un solo DataArray a lo largo del tiempo\n",
        "    # (Esto puede tardar varios minutos y consumir RAM si son muchos archivos)\n",
        "    ds_h2o = xr.concat(h2o_data_list, dim='time').sortby('time')\n",
        "    ds_temp = xr.concat(temp_data_list, dim='time').sortby('time')\n",
        "\n",
        "    print(\"\\n--- DataArray de H2O Procesado (ds_h2o) ---\")\n",
        "    print(ds_h2o)\n",
        "\n",
        "    print(\"\\n--- DataArray de Temperatura Procesado (ds_temp) ---\")\n",
        "    print(ds_temp)\n",
        "\n",
        "    print(\"\\nPreprocesamiento completado.\")\n",
        "    print(\"Las variables 'ds_h2o' y 'ds_temp' están listas para el análisis.\")\n",
        "\n",
        "else:\n",
        "    print(\"\\nNo se pudieron cargar los datos. Verifica las rutas y los archivos.\")"
      ],
