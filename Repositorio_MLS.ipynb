      "cell_type": "markdown",
      "source": [
        "Optimización y Procesamiento Anual por Lotes\n",
        "\n",
        "Dada la masividad de la base de datos del instrumento MLS (abarcando el periodo 2005-2025), el procesamiento secuencial en una única iteración genera un desbordamiento de la memoria RAM. Para mitigar este cuello de botella, esta sección implementa una rutina de procesamiento por lotes iterativos (Batch Processing).\n",
        "\n",
        "La función process_by_year agrupa los perfiles satelitales en ventanas anuales, concatena los tensores dimensionales y exporta el resultado consolidado a archivos NetCDF (.nc) independientes. Crucialmente, el algoritmo incorpora rutinas explícitas de liberación de memoria (gc.collect()) al finalizar cada ciclo, garantizando la viabilidad computacional necesaria para construir las series temporales continuas utilizadas en el análisis del Tape Recorder."
      ],
      "metadata": {
        "id": "_GNEvRB7W965"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import xarray as xr\n",
        "import numpy as np\n",
        "import os\n",
        "import glob\n",
        "import warnings\n",
        "import h5py\n",
        "import gc # Garbage Collector para liberar RAM\n",
        "\n",
        "# --- Configuración Inicial ---\n",
        "warnings.filterwarnings(\"ignore\", category=UserWarning, module=\"h5py\")\n",
        "\n",
        "# RUTAS\n",
        "H2O_DATA_PATH = os.path.join(BASE_DIR, \"DatosMLS\")\n",
        "TEMP_DATA_PATH = os.path.join(BASE_DIR, \"DatosMLS_Temp\")\n",
        "OUTPUT_DIR = os.path.join(BASE_DIR, \"DatosProcesados\")\n",
        "\n",
        "# Crear carpeta de salida si no existe\n",
        "if not os.path.exists(OUTPUT_DIR):\n",
        "    os.makedirs(OUTPUT_DIR)\n",
        "\n",
        "# --- Función de Carga (La misma que ya funcionó) ---\n",
        "def load_and_preprocess_mls(file_path, var_name, var_swath_name):\n",
        "    try:\n",
        "        with h5py.File(file_path, 'r') as f:\n",
        "            base_path = f\"HDFEOS/SWATHS/{var_swath_name}\"\n",
        "\n",
        "            # Rutas\n",
        "            data_path = f\"{base_path}/Data Fields/L2gpValue\"\n",
        "            prec_path = f\"{base_path}/Data Fields/L2gpPrecision\"\n",
        "            lat_path = f\"{base_path}/Geolocation Fields/Latitude\"\n",
        "            lon_path = f\"{base_path}/Geolocation Fields/Longitude\"\n",
        "            time_path = f\"{base_path}/Geolocation Fields/Time\"\n",
        "            press_path = f\"{base_path}/Geolocation Fields/Pressure\"\n",
        "\n",
        "            # Lectura\n",
        "            data_raw = f[data_path][:]\n",
        "            precision = f[prec_path][:]\n",
        "            latitude = f[lat_path][:]\n",
        "            longitude = f[lon_path][:]\n",
        "            time_raw = f[time_path][:]\n",
        "            pressure = f[press_path][:]\n",
        "\n",
        "            # Filtrado y Conversiones\n",
        "            data_filtered = np.where(precision > 0, data_raw, np.nan)\n",
        "            time_datetime = (time_raw.astype('timedelta64[s]') +\n",
        "                             np.datetime64('1993-01-01T00:00:00Z'))\n",
        "\n",
        "            # Creación DataArray\n",
        "            da = xr.DataArray(\n",
        "                data_filtered,\n",
        "                coords={\n",
        "                    'nTimes': time_datetime,\n",
        "                    'pressure': pressure,\n",
        "                    'lat': ('nTimes', latitude),\n",
        "                    'lon': ('nTimes', longitude)\n",
        "                },\n",
        "                dims=['nTimes', 'pressure'],\n",
        "                name=var_name\n",
        "            )\n",
        "            return da.rename({'nTimes': 'time'})\n",
        "\n",
        "    except Exception as e:\n",
        "        # Errores puntuales en archivos se ignoran para no detener el proceso\n",
        "        return None\n",
        "\n",
        "# --- Función para Procesar por Lotes Anuales ---\n",
        "\n",
        "def process_by_year(source_path, var_name, swath_name, start_year=2005, end_year=2025):\n",
        "\n",
        "    print(f\"--- Iniciando procesamiento para: {var_name} ---\")\n",
        "\n",
        "    for year in range(start_year, end_year + 1):\n",
        "        year_str = str(year)\n",
        "\n",
        "        # Nombre del archivo de salida\n",
        "        output_filename = f\"MLS_{var_name}_{year_str}.nc\"\n",
        "        output_path = os.path.join(OUTPUT_DIR, output_filename)\n",
        "\n",
        "        # Verificar si ya existe para no repetir trabajo\n",
        "        if os.path.exists(output_path):\n",
        "            print(f\"Año {year} ya procesado. Saltando...\")\n",
        "            continue\n",
        "\n",
        "        print(f\"Procesando año {year}...\")\n",
        "\n",
        "        # Buscar archivos SOLO de ese año\n",
        "        # Asumimos estructura .../DatosMLS/2005/archivo.he5\n",
        "        # Si tus archivos están todos mezclados, usa glob recursivo y filtra el string\n",
        "        year_files = sorted(glob.glob(os.path.join(source_path, year_str, \"*.he5\")))\n",
        "\n",
        "        # Si no encuentra por carpeta de año, busca recursivo general y filtra\n",
        "        if not year_files:\n",
        "            all_files = glob.glob(os.path.join(source_path, \"**\", \"*.he5\"), recursive=True)\n",
        "            year_files = [f for f in all_files if year_str in os.path.basename(f)]\n",
        "\n",
        "        if not year_files:\n",
        "            print(f\"  No se encontraron archivos para el año {year}\")\n",
        "            continue\n",
        "\n",
        "        # Cargar archivos del año\n",
        "        yearly_data = []\n",
        "        for f in year_files:\n",
        "            da = load_and_preprocess_mls(f, var_name, swath_name)\n",
        "            if da is not None:\n",
        "                yearly_data.append(da)\n",
        "\n",
        "        if yearly_data:\n",
        "            # Concatenar solo este año\n",
        "            ds_year = xr.concat(yearly_data, dim='time').sortby('time')\n",
        "\n",
        "            # Guardar a disco inmediatamente\n",
        "            ds_year.to_netcdf(output_path)\n",
        "            print(f\"  -> Guardado: {output_filename}\")\n",
        "\n",
        "            # LIBERAR MEMORIA\n",
        "            del ds_year\n",
        "            del yearly_data\n",
        "            gc.collect() # Forzar al recolector de basura de Python\n",
        "        else:\n",
        "            print(f\"  Datos vacíos para el año {year}\")\n",
        "\n",
        "# --- EJECUCIÓN ---\n",
        "\n",
        "# 1. Procesar H2O\n",
        "process_by_year(H2O_DATA_PATH, \"H2O\", \"H2O\", 2005, 2025)\n",
        "\n",
        "# 2. Procesar Temperatura\n",
        "process_by_year(TEMP_DATA_PATH, \"Temp\", \"Temperature\", 2005, 2025)\n",
        "\n",
        "print(\"\\n¡Todo el procesamiento ha terminado!\")"
      ],
