    {
      "cell_type": "code",
      "source": [
        "import xarray as xr\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import glob\n",
        "import os\n",
        "from joblib import Parallel, delayed\n",
        "import warnings\n",
        "\n",
        "warnings.filterwarnings(\"ignore\")\n",
        "\n",
        "# ================= CONFIGURACIÓN =================\n",
        "TARGET_PRESSURE = 100.0  # El nivel que te interesa para los mapas/videos\n",
        "\n",
        "# Rutas de tus datos\n",
        "RUTAS = {\n",
        "    'H2O': os.path.join(BASE_DIR, 'DatosMLS'),\n",
        "    'Temperature': os.path.join(BASE_DIR, 'DatosMLS_Temp')\n",
        "}\n",
        "\n",
        "def procesar_un_archivo(filepath, product_name, target_press):\n",
        "    \"\"\"Extrae datos de UN archivo individualmente.\"\"\"\n",
        "    path_data = f'HDFEOS/SWATHS/{product_name}/Data Fields'\n",
        "    path_geo  = f'HDFEOS/SWATHS/{product_name}/Geolocation Fields'\n",
        "\n",
        "    try:\n",
        "        # Abrir GEOLOCATON\n",
        "        with xr.open_dataset(filepath, group=path_geo, engine='h5netcdf') as ds_g:\n",
        "            press = ds_g['Pressure'].values\n",
        "            # Verificación rápida para no procesar si no tiene el nivel\n",
        "            if np.min(np.abs(press - target_press)) > 5.0: return None\n",
        "\n",
        "            lat = ds_g['Latitude'].values\n",
        "            lon = ds_g['Longitude'].values\n",
        "            time = ds_g['Time'].values # Segundos desde 1993\n",
        "\n",
        "        # Abrir DATA\n",
        "        idx_lev = (np.abs(press - target_press)).argmin()\n",
        "\n",
        "        with xr.open_dataset(filepath, group=path_data, engine='h5netcdf') as ds_d:\n",
        "            val = ds_d['L2gpValue'].values[:, idx_lev]\n",
        "            prec = ds_d['L2gpPrecision'].values[:, idx_lev]\n",
        "            qual = ds_d['Quality'].values\n",
        "            status = ds_d['Status'].values\n",
        "            # Convergencia solo existe en algunos productos, manejamos excepción\n",
        "            try: conv = ds_d['Convergence'].values\n",
        "            except: conv = np.zeros_like(qual)\n",
        "\n",
        "        # Filtros de Calidad (Estrictos)\n",
        "        # H2O usa limite conv < 2.0, Temp es menos estricto pero < 2.0 funciona bien para ambos\n",
        "        mask = (prec > 0) & ((status.astype(int) % 2) == 0) & \\\n",
        "               (qual > 0.2) & (conv < 2.0)\n",
        "\n",
        "        if not np.any(mask): return None\n",
        "\n",
        "        # Crear un DataFrame pequeño para este archivo\n",
        "        df = pd.DataFrame({\n",
        "            'time': time[mask],\n",
        "            'lat': lat[mask],\n",
        "            'lon': lon[mask],\n",
        "            'value': val[mask]\n",
        "        })\n",
        "        return df\n",
        "\n",
        "    except Exception as e:\n",
        "        return None\n",
        "\n",
        "def generar_dataset_optimizado(variable):\n",
        "    print(f\"--> Iniciando optimización masiva para: {variable}\")\n",
        "    folder = RUTAS[variable]\n",
        "    files = sorted(glob.glob(os.path.join(folder, '**', '*.he5'), recursive=True))\n",
        "\n",
        "    # EJECUCIÓN PARALELA: Usamos todos los cores disponibles\n",
        "    # n_jobs=-1 usa todos los núcleos. verbose=5 muestra barra de progreso.\n",
        "    print(f\"    Procesando {len(files)} archivos en paralelo...\")\n",
        "\n",
        "    # Esta lista contendrá muchos DataFrames pequeños\n",
        "    dfs = Parallel(n_jobs=-1, verbose=5)(\n",
        "        delayed(procesar_un_archivo)(f, variable, TARGET_PRESSURE) for f in files\n",
        "    )\n",
        "\n",
        "    # Limpiar Nones (archivos fallidos)\n",
        "    dfs = [d for d in dfs if d is not None]\n",
        "\n",
        "    if len(dfs) > 0:\n",
        "        print(\"    Consolidando datos...\")\n",
        "        # Unir todo en un solo DataFrame gigante\n",
        "        df_total = pd.concat(dfs, ignore_index=True)\n",
        "\n",
        "        # Convertir tiempo a fecha real de una vez\n",
        "        t0 = np.datetime64('1993-01-01T00:00:00')\n",
        "        df_total['date'] = t0 + df_total['time'].astype('timedelta64[s]')\n",
        "        df_total.drop(columns=['time'], inplace=True) # Ya no necesitamos los segundos\n",
        "\n",
        "        # GUARDAR EN FORMATO RÁPIDO (Parquet)\n",
        "        output_file = os.path.join(BASE_DIR, f'DATOS_OPTIMIZADOS_{variable}_100hPa.parquet')\n",
        "        df_total.to_parquet(output_file)\n",
