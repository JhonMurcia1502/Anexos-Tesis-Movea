    {
      "cell_type": "markdown",
      "source": [
        " Análisis de Series Temporales y generación de Tape Recorder:\n",
        " Una vez consolidados los archivos anuales, esta sección ejecuta la reconstrucción del transporte vertical multianual del vapor de agua (2005-2025). Utilizando open_mfdataset, se ensambla un tensor continuo que es posteriormente segmentado según los dominios latitudinales de las principales celdas de circulación (Hadley, Ferrel y Polar).Para visualizar la cinemática del ascenso de las parcelas de aire, se aplica un submuestreo (resample) mensual continuo y se implementa la aproximación hipsométrica ($Z \\approx -H \\ln(P/P_0)$), asumiendo una escala de altura de referencia de $\\approx 7 \\text{ km}$. El resultado gráfico (isolineas termodinámicas mediante interpolación de contornos rellenos) permite identificar empíricamente la firma del Atmospheric Tape Recorder y eventos disruptivos a largo plazo en la estratosfera inferior."
      ],
      "metadata": {
        "id": "wYs9qarPXnoO"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import xarray as xr\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "import glob\n",
        "import os\n",
        "import matplotlib.dates as mdates\n",
        "import warnings\n",
        "\n",
        "warnings.filterwarnings('ignore')\n",
        "\n",
        "print(\"Generando Series de Tiempo (Tape Recorder Absoluto) por regiones...\")\n",
        "\n",
        "# --- 1. CARGA DE DATOS MULTIANUAL ---\n",
        "archivos_h2o = sorted(glob.glob(os.path.join(BASE_DIR, \"MLS_H2O_*.nc\")))\n",
        "\n",
        "if not archivos_h2o:\n",
        "    raise FileNotFoundError(\"No se encontraron archivos .nc.\")\n",
        "\n",
        "ds = xr.open_mfdataset(\n",
        "    archivos_h2o,\n",
        "    combine='nested',\n",
        "    concat_dim='time',\n",
        "    parallel=True\n",
        ")\n",
        "\n",
        "# --- 2. DEFINICIÓN DE REGIONES (Células Atmosféricas) ---\n",
        "# Usamos un diccionario para definir los límites de cada zona\n",
        "regiones = {\n",
        "    'Tropical (Celda de Hadley)': {'lat_min': -20, 'lat_max': 20},\n",
        "    'Latitudes Medias (Celda de Ferrel)': {'lat_min': 30, 'lat_max': 60}, # Puedes hacer también el Hemisferio Sur (-60 a -30)\n",
        "    'Polar (Celda Polar)': {'lat_min': 65, 'lat_max': 90}\n",
        "}\n",
        "\n",
        "# Iteramos sobre cada región para generar su gráfica\n",
        "for nombre_region, limites in regiones.items():\n",
        "    print(f\"\\nProcesando región: {nombre_region}...\")\n",
        "\n",
        "    # --- 3. FILTRO DE LATITUD ---\n",
        "    lat_mask = ((ds.lat >= limites['lat_min']) & (ds.lat <= limites['lat_max'])).compute()\n",
        "    ds_region = ds.where(lat_mask, drop=True)\n",
        "\n",
        "    # Si no hay datos en esa latitud (raro, pero posible si el filtro es muy estrecho), saltamos\n",
        "    if ds_region.time.size == 0:\n",
        "        print(f\"  Sin datos para {nombre_region}. Saltando.\")\n",
        "        continue\n",
        "\n",
        "    # --- 4. PROMEDIO MENSUAL CONTINUO ---\n",
